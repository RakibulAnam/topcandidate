    "test-music": "node scripts/make-test-music.mjs"
  },
  "devDependencies": {
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
