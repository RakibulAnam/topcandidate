    "build": "node scripts/build.mjs",
    "check": "node scripts/render.mjs --check-only",
    "preview": "node scripts/render.mjs --preview",
    "studio": "node scripts/studio.mjs",
    "render": "node scripts/render.mjs --final",
    "snapshot": "node scripts/render.mjs --snapshot",
    "capture-ui": "node scripts/capture-ui.mjs",
