  "version": "0.1.0",
  "description": "Local-only AI video editing studio for TopCandidate short-form content (HyperFrames-based). Not part of the web app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "new": "node scripts/new-project.mjs",
